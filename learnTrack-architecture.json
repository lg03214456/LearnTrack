  "cards": [
    { "dot": "rose", "title": "關鍵缺口 (P0)", "items": [
      "無 Server Actions — 寫入操作無驗證、無權限",
      "無 Domain Services — 業務規則在 Client onClick",
      "Client 直接 import @/server/domain/types — 違反邊界",
      "Repository 直接回傳 View Model — 缺少 Mapping",
      "ORG 硬編碼 org-001 — 無多租戶"
    ]},
    { "dot": "orange", "title": "架構不符 (P1)", "items": [
      "文檔宣稱有 Action/Service，實際不存在",
      "目錄非 Feature-based (engineering-standards §3)",
      "型別未分層：Entity/Enum/VM 混在 types.ts",
      "無輸入驗證、無統一錯誤代碼"
    ]},
    { "dot": "emerald", "title": "已就緒", "items": [
      "Next.js 16 + React 19 + TS strict",
      "Repository Interface 定義良好",
      "Mock Fixtures 集中管理、關聯完整",
      "Vitest + Testing Library 就緒",
      "Shell/Navigation/UI 元件可複用"
    ]}
  ]
