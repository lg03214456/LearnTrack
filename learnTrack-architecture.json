  "connections": [
    { "id": "browser-to-sc", "from": "browser", "to": "server-components", "label": "HTTPS 請求", "variant": "emphasis" },
    { "id": "sc-to-cc", "from": "server-components", "to": "client-components", "label": "傳遞 ViewModel", "labelDy": 24 },
